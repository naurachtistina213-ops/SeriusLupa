# Token bot dari @BotFather
TELEGRAM_BOT_TOKEN=

# ID spreadsheet utama (dari URL sheets: .../d/<INI_ID_NYA>/edit)
SPREADSHEET_ID=

# Credential service account Google, di-encode base64.
# Cara generate: base64 -w0 credentials.json  (Linux/Mac)
GOOGLE_CREDENTIALS_BASE64=

# user_id superadmin, dipisah koma. Contoh: 111222333,444555666
SUPERADMIN_IDS=

# Timezone default kalau team belum atur sendiri
DEFAULT_TIMEZONE=Asia/Jakarta
